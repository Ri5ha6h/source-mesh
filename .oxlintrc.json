{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }],
    "eslint/no-await-in-loop": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "artifacts/**",
    "design/**",
    "research/**",
    "phase/**"
  ]
}
